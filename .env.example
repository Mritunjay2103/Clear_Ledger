# ClearLedger configuration.
# Copy to .env and adjust. These defaults run the app immediately with no API key.

# development | production. A production profile refuses to start without reviewer credentials.
APP_ENV=development

# Runtime storage: SQLite database, uploaded PDFs, temporary render files.
# A relative path is resolved once, against the repository root, by backend/app/config.py.
# The Docker image sets this to /data, which must be a durable mounted volume.
DATA_DIR=./runtime-data

# rules | ollama | openai_compatible
# 'rules' is the deterministic parser: no key, no model download, works offline.
EXTRACTION_PROVIDER=rules

# Local model extraction. Nothing is downloaded automatically; set OLLAMA_MODEL to a model
# you already have (see `ollama list`), for example: qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# One OpenAI-compatible chat-completions endpoint. Credentials stay server-side.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# When a model provider fails, do NOT silently substitute the deterministic parser.
# Turning this on records the original failure and the limitations of the fallback result.
ALLOW_RULES_FALLBACK=false

# Intake and runtime limits.
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
MAX_QUEUE_DEPTH=10
OCR_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60

# State-changing requests per minute, per client address. A brake on runaway
# scripts. scripts/smoke_demo.py submits every scenario back to back and needs
# a higher value; set 0 to disable the limit entirely.
RATE_LIMIT_PER_MINUTE=60

PORT=8000

# Private reviewer access (HTTP Basic over HTTPS). Leave blank for local development;
# both must be set for a hosted deployment, and the password must be at least 12 characters.
# There is no default password.
DEMO_USERNAME=
DEMO_PASSWORD=

# Origins allowed to perform browser mutations. The Vite dev server runs on 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
